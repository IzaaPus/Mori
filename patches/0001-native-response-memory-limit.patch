diff --git a/android/app/src/main/java/com/mori/downloader/MainActivity.java b/android/app/src/main/java/com/mori/downloader/MainActivity.java
--- a/android/app/src/main/java/com/mori/downloader/MainActivity.java
+++ b/android/app/src/main/java/com/mori/downloader/MainActivity.java
@@ -56,3 +56,31 @@
+    // Do not allow the generic JavaScript HTTP bridge to buffer entire videos
+    // or large galleries in the Android heap. Media downloads must use the
+    // streaming file-transfer path instead.
+    private static byte[] readBodyLimited(okhttp3.ResponseBody body, int maxBytes)
+            throws java.io.IOException {
+        if (body == null) return new byte[0];
+        if (body.contentLength() > maxBytes) {
+            body.close();
+            throw new java.io.IOException(
+                    "HTTP response exceeds the 4 MiB in-memory limit; use the streaming downloader.");
+        }
+        try (InputStream input = body.byteStream();
+             ByteArrayOutputStream output = new ByteArrayOutputStream(8192)) {
+            byte[] chunk = new byte[8192];
+            int total = 0;
+            int count;
+            while ((count = input.read(chunk)) != -1) {
+                if (count > maxBytes - total) {
+                    throw new java.io.IOException(
+                            "HTTP response exceeds the 4 MiB in-memory limit; use the streaming downloader.");
+                }
+                output.write(chunk, 0, count);
+                total += count;
+            }
+            return output.toByteArray();
+        }
+    }
+
     static {
         try {
             System.loadLibrary("morisec");
@@ -246,8 +274,6 @@
-                String resData;
