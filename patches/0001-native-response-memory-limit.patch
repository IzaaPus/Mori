-                    byte[] bytes = res.body() != null ? res.body().bytes() : new byte[0];
-                    resData = Base64.encodeToString(bytes, Base64.NO_WRAP);
-                } else {
-                    resData = res.body() != null ? res.body().string() : "";
-                }
+                boolean binaryResponse = "arraybuffer".equals(respType) || "blob".equals(respType);
+                byte[] responseBytes = readBodyLimited(res.body(), 4 * 1024 * 1024);
+                String resData = binaryResponse
+                        ? Base64.encodeToString(responseBytes, Base64.NO_WRAP)
+                        : new String(responseBytes, java.nio.charset.StandardCharsets.UTF_8);

